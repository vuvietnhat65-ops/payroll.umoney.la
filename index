    <style>
        :root {
            --umoney-orange: #ea580c;
            --umoney-blue: #1e3a8a;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            overflow: hidden; /* For slide presentation feel */
            margin: 0;
            padding: 0;
        }

        h1, h2, h3, h4 {
            font-family: 'Poppins', sans-serif;
            color: #0f172a;
            letter-spacing: -0.02em;
        }

        /* Improved Typography and Spacing */
        p {
            line-height: 1.75;
            margin-bottom: 1.25rem;
            font-size: 1.125rem;
            color: #475569;
        }

        li {
            line-height: 1.6;
        }

        /* Slide Container Setup */
        .slider-container {
            height: 100vh;
            width: 100vw;
            overflow-y: scroll;
            scroll-snap-type: none;
            scroll-behavior: smooth;
        }

        .slide {
            height: 100vh;
            width: 100vw;
            scroll-snap-align: start;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 2rem;
        }

        /* Glassmorphism Panels */
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 3rem;
            max-width: 1200px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .glass-panel::-webkit-scrollbar { width: 6px; }
        .glass-panel::-webkit-scrollbar-track { background: transparent; }
        .glass-panel::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        /* Highlight Badge */
        .highlight-badge {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 9999px;
            font-weight: 800;
            display: inline-block;
            box-shadow: 0 10px 15px -3px rgba(234, 88, 12, 0.4);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            animation: pulse-shadow 2s infinite;
        }

        @keyframes pulse-shadow {
            0% { box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.5); }
            70% { box-shadow: 0 0 0 20px rgba(234, 88, 12, 0); }
            100% { box-shadow: 0 0 0 0 rgba(234, 88, 12, 0); }
        }

        /* Navigation Dots */
        .nav-dots {
            position: fixed;
            right: 2rem;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 50;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #cbd5e1;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .dot.active {
            background-color: var(--umoney-orange);
            transform: scale(1.5);
        }

        /* Decorative Elements */
        .bg-shape-1 {
            position: absolute; top: -10%; left: -10%; width: 50vw; height: 50vw;
            background: radial-gradient(circle, rgba(234,88,12,0.1) 0%, rgba(255,255,255,0) 70%);
            z-index: -1; pointer-events: none;
        }
        .bg-shape-2 {
            position: absolute; bottom: -10%; right: -10%; width: 60vw; height: 60vw;
            background: radial-gradient(circle, rgba(30,58,138,0.08) 0%, rgba(255,255,255,0) 70%);
            z-index: -1; pointer-events: none;
        }
        
        /* List Styling */
        .feature-list li {
            position: relative;
            padding-left: 3rem;
            margin-bottom: 2rem;
        }
        .feature-list li i {
            position: absolute;
            left: 0;
            top: 0.25rem;
            color: var(--umoney-orange);
            font-size: 1.5rem;
        }
        
        .gradient-text {
            background: linear-gradient(90deg, #1e3a8a 0%, #ea580c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @page {
            size: A4 portrait;
            margin: 15mm;
        }

        @media print {
            body {
                overflow: visible !important;
                background-color: white !important;
                color: #000 !important;
            }
            .slider-container {
                height: auto !important;
                width: auto !important;
                overflow: visible !important;
            }
            .slide {
                position: static !important;
                display: block !important;
                height: auto !important;
                width: 180mm !important;
                max-width: 180mm !important;
                margin: 0 auto !important;
                padding: 0 !important;
                page-break-after: always !important;
                break-after: page !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
                box-sizing: border-box !important;
            }
            .slide:last-of-type {
                page-break-after: auto !important;
                break-after: auto !important;
            }
            .glass-panel {
                max-height: none !important;
                overflow: visible !important;
                box-shadow: none !important;
                border: none !important;
                background: transparent !important;
                backdrop-filter: none !important;
                padding: 1rem !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }
            .nav-dots,
            .print-button,
            .bg-shape-1,
            .bg-shape-2 {
                display: none !important;
            }
            .feature-list li i {
                display: inline-block !important;
            }
        }
    </style>
